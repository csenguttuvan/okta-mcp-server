# ==============================================================================
# Okta MCP Server Configuration
# ==============================================================================

# Your Okta Organization Base URL (Required)
OKTA_API_BASE_URL=https://your-org.okta.com

# ------------------------------------------------------------------------------
# Authentication Method 1: API Token (SSWS) - Recommended for individual setup
# Obtain from: Okta Admin -> Security -> API -> Tokens -> Create Token
# ------------------------------------------------------------------------------
OKTA_API_TOKEN=00your_api_token_here

# ------------------------------------------------------------------------------
# Authentication Method 2: OAuth 2.0 Private Key JWT (Enterprise / Service App)
# If OKTA_API_TOKEN is not set, the server will look for these credentials:
# ------------------------------------------------------------------------------
# OKTA_CLIENT_ID=0oayourclientid
# OKTA_PRIVATE_KEY_PATH=/path/to/private_key.pem
# OKTA_SCOPES="okta.users.manage okta.groups.manage okta.apps.manage okta.policies.manage okta.logs.read"

# ------------------------------------------------------------------------------
# Server Options
# ------------------------------------------------------------------------------
# Transport: stdio (default, recommended for Claude/Cursor) or sse / http
MCP_TRANSPORT=stdio

# Read-only mode: set to "true" to only load read-only inspection tools
# OKTA_READ_ONLY=false

# Logging level: DEBUG, INFO, WARNING, ERROR
OKTA_LOG_LEVEL=INFO
